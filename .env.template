# Shared local-ai machine configuration.
#
# Setup uses this schema version to detect and stage config migrations. Leave it
# unchanged unless the checked-in template changes it.
LOCAL_AI_CONFIG_VERSION=2

# This file is created interactively by the first service's ./setup.sh.
# Service-specific .env files inherit these values and should only override them
# when that service genuinely needs a different location or bind address.

# Canonical model repositories shared by more than one runtime. Large model
# repositories downloaded explicitly by local-ai are stored here and normally
# mounted read-only into service containers.
HF_REPOS_ROOT=/data/hf-repos

# Mutable private state owned by individual services. A service that leaves its
# *_DATA_ROOT override blank gets a directory below this root.
LOCAL_AI_SERVICE_ROOT=/data/local-ai/services

# Data intentionally exchanged between services. Individual workspaces are
# mounted only when a workflow asks for them.
LOCAL_AI_WORKSPACES_ROOT=/data/local-ai/workspaces

# Web UIs bind only to this machine unless you deliberately change this value.
LOCAL_AI_BIND_ADDRESS=127.0.0.1

# Optional host credential used by Hugging Face downloads when a repository
# requires authentication. Leave commented when it is not needed.
# HF_TOKEN=hf_...
