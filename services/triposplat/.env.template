# TripoSplat-specific configuration.
# Setup uses this to detect service config migrations. Leave unchanged.
LOCAL_AI_SERVICE_CONFIG_VERSION=2

# Shared storage and bind defaults come from ../../.env.

# Leave blank to use {LOCAL_AI_SERVICE_ROOT}/triposplat.
TRIPOSPLAT_DATA_ROOT=

TRIPOSPLAT_PORT=7861
TRIPOSPLAT_GPU=0

TRIPOSPLAT_REPO=https://github.com/VAST-AI-Research/TripoSplat.git
# Exploratory default. Pin to a known commit when preserving a working build.
TRIPOSPLAT_REF=main
TRIPOSPLAT_IMAGE=local/triposplat:latest

# PyTorch wheels bundle the CUDA runtime; the host needs a compatible NVIDIA
# driver and NVIDIA Container Toolkit.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
