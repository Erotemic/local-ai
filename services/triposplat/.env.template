HF_REPOS_ROOT=/data/hf-repos
TRIPOSPLAT_DATA_ROOT=/data/service/triposplat
LOCAL_AI_BIND_ADDRESS=127.0.0.1

TRIPOSPLAT_PORT=7861
TRIPOSPLAT_GPU=0

TRIPOSPLAT_REPO=https://github.com/VAST-AI-Research/TripoSplat.git
# Exploratory default. Pin to a commit for reproducible rebuilds.
TRIPOSPLAT_REF=main
TRIPOSPLAT_IMAGE=local/triposplat:latest

# PyTorch wheels bundle the CUDA runtime; the host still needs a compatible
# NVIDIA driver and NVIDIA Container Toolkit.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# Optional; only needed by host-side hf download if access policy changes.
# HF_TOKEN=hf_...
