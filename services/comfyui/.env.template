# ComfyUI-specific configuration.
# Setup uses this to detect service config migrations. Leave unchanged.
LOCAL_AI_SERVICE_CONFIG_VERSION=2

# Shared storage and bind defaults come from ../../.env.

# Leave blank to use {LOCAL_AI_SERVICE_ROOT}/comfyui.
COMFY_DATA_ROOT=

COMFYUI_PORT=8188

# Optional comma-separated bundles provisioned by ./setup.sh.
# Available now: minimax-h3
# Leave blank for a model-agnostic ComfyUI installation.
COMFYUI_MODEL_BUNDLES=

# Current ComfyUI source revision used by this recipe.
# Pin BASE_COMFYUI_IMAGE to a digest/tag as well when rebuild reproducibility is
# more important than following the current base image.
BASE_COMFYUI_IMAGE=ghcr.io/lecode-official/comfyui-docker:latest
COMFYUI_IMAGE=local/comfyui:v0.31.0
COMFYUI_REF=v0.31.0

USER_ID=1000
GROUP_ID=1000

# "auto" chooses the GPU with the widest active PCIe link. Set an explicit
# NVIDIA index if desired.
PRIMARY_GPU=auto
