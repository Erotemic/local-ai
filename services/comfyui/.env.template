# Host storage.
HF_REPOS_ROOT=/data/hf-repos
COMFY_DATA_ROOT=/data/service/comfyui

# Bind web UI to loopback unless LAN exposure is explicitly wanted.
LOCAL_AI_BIND_ADDRESS=127.0.0.1
COMFYUI_PORT=8188

# Current ComfyUI source revision used by this recipe.
# Pin BASE_COMFYUI_IMAGE to a digest/tag as well when rebuild reproducibility is
# more important than following the current base image.
BASE_COMFYUI_IMAGE=ghcr.io/lecode-official/comfyui-docker:latest
COMFYUI_IMAGE=local/comfyui:v0.31.0
COMFYUI_REF=v0.31.0

USER_ID=1000
GROUP_ID=1000

# "auto" chooses the GPU with the widest active PCIe link. Set an explicit
# NVIDIA index if desired.
PRIMARY_GPU=auto

# Optional; only needed by host-side hf download commands for gated repos.
# HF_TOKEN=hf_...
