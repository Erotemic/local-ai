# Local TTS service configuration.
# Setup uses this to detect service config migrations. Leave unchanged.
LOCAL_AI_SERVICE_CONFIG_VERSION=1

# Shared storage and bind defaults come from ../../.env.

# Leave blank to use {LOCAL_AI_SERVICE_ROOT}/tts.
TTS_DATA_ROOT=

# Wavhost is the primary service. The default model list is deliberately small
# for the first GTX 1080 Ti experiment; add comma-separated registry names or
# use ./setup.sh --with-model <name> for additional Wavhost models.
TTS_WAVHOST_MODELS=qwen-0.6-customvoice
TTS_WAVHOST_PORT=11435
TTS_WAVHOST_GPU=1
TTS_WAVHOST_IMAGE=local/wavhost:pascal

# Qwen dtype policy implemented in the wavhost submodule patch.
# auto => Ampere+ BF16, Volta/Turing FP16, Pascal/Maxwell FP32.
# On a 1080 Ti, compare float32 and float16 experimentally before overriding.
WAVHOST_QWEN_DTYPE=auto

# Keep one loaded backend warm between reader chunks. A size of one avoids
# retaining multiple large models on the same 11 GB GPU; 0 disables caching.
WAVHOST_BACKEND_CACHE_SIZE=1

# PyTorch 2.14 + CUDA 12.6 is the last official PyTorch release line/build
# family retaining Pascal binaries. CUDA 13.x drops pre-Turing architectures.
TTS_TORCH_VERSION=2.14.0
# TorchAudio entered maintenance mode at 2.11 and declares compatibility with
# future PyTorch versions, so it is pinned separately rather than assumed to
# share PyTorch's version number.
TTS_TORCHAUDIO_VERSION=2.11.0
TTS_TORCH_CUDA_TAG=cu126
TTS_QWEN_TTS_VERSION=0.1.1

# Known-good accelerated Kokoro baseline retained alongside Wavhost for A/B
# testing and Android-reader compatibility.
TTS_KOKORO_PORT=8880
TTS_KOKORO_GPU=0
TTS_KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:v0.3.0-amd64

# Benchmark defaults. These do not affect the servers themselves.
# Leave blank to store retained WAV/metadata artifacts under
# {TTS_DATA_ROOT}/benchmarks.
TTS_BENCH_OUTPUT_DIR=
TTS_BENCH_QWEN_MODEL=qwen-0.6-customvoice
TTS_BENCH_QWEN_VOICE=Ryan
TTS_BENCH_KOKORO_MODEL=kokoro
TTS_BENCH_KOKORO_VOICE=af_heart
