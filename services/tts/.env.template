# Local TTS service configuration.
# Setup uses this to detect service config migrations. Leave unchanged.
LOCAL_AI_SERVICE_CONFIG_VERSION=3

# Shared storage and bind defaults come from ../../.env.

# Leave blank to use {LOCAL_AI_SERVICE_ROOT}/tts.
TTS_DATA_ROOT=

# Wavhost is the primary service. The default model list is deliberately small
# for the GTX 1080 Ti baseline; add comma-separated registry names or use
# ./setup.sh --with-model <name> for additional Wavhost models.
TTS_WAVHOST_MODELS=qwen-0.6-customvoice
TTS_WAVHOST_PORT=11435
TTS_WAVHOST_GPU=1
TTS_WAVHOST_IMAGE=local/wavhost:pascal

# Force HTTP-served Wavhost models onto the GPU reserved for this container.
# Set to auto to restore each registry model's recommendation (Kokoro currently
# recommends CPU), or cpu/mps for explicit experiments.
WAVHOST_DEVICE=cuda

# Qwen dtype policy implemented in the wavhost submodule patch.
# auto => Ampere+ BF16, Volta/Turing FP16, Pascal/Maxwell FP32.
WAVHOST_QWEN_DTYPE=auto

# Keep one loaded backend warm between reader chunks. A size of one avoids
# retaining multiple large models on the same 11 GB GPU; 0 disables caching.
WAVHOST_BACKEND_CACHE_SIZE=1

# PyTorch 2.14 + CUDA 12.6 is the last official PyTorch release line/build
# family retaining Pascal binaries. CUDA 13.x drops pre-Turing architectures.
TTS_TORCH_VERSION=2.14.0
# TorchAudio entered maintenance mode at 2.11 and declares compatibility with
# future PyTorch versions, so it is pinned separately rather than assumed to
# share PyTorch's version number.
TTS_TORCHAUDIO_VERSION=2.11.0
TTS_TORCH_CUDA_TAG=cu126
TTS_QWEN_TTS_VERSION=0.1.1

# Experimental genuinely-quantized qwentts.cpp backend. Its cuda12 image is
# built for Pascal sm_61 and newer. Models are provisioned separately with:
#   ./setup.sh --with-model qwen-0.6-customvoice-q8-gguf
# This backend intentionally gets its own port/model identity rather than
# silently changing what the Wavhost model name means.
TTS_QWENTTS_PORT=11436
TTS_QWENTTS_GPU=1
TTS_QWENTTS_IMAGE=ghcr.io/serveurpersocom/qwentts.cpp:cuda12
TTS_QWENTTS_MODEL_ALIAS=qwen-0.6-customvoice-q8-ggml
TTS_QWENTTS_MODEL_FILE=qwen-talker-0.6b-customvoice-Q8_0.gguf
TTS_QWENTTS_CODEC_FILE=qwen-tokenizer-12hz-Q8_0.gguf
TTS_QWENTTS_LANGUAGE=English
# For one-off experiments, prefer an invocation override such as
#   TTS_QWENTTS_CLAMP_FP16=0 ./start-qwentts.sh
# rather than editing .env. start-qwentts.sh preserves explicit TTS_QWENTTS_*
# variables and prints the effective runtime configuration before launch.
# qwentts.cpp documents clamping as protection for FP16 intermediate state on
# sub-Ampere CUDA targets. Keep it on for the Pascal experiment.
TTS_QWENTTS_CLAMP_FP16=1
# Leave flash attention enabled for the first run. If the Pascal backend rejects
# it or regresses, set this to 1 and rerun before abandoning the runtime.
TTS_QWENTTS_NO_FA=0
# Maximum seconds start-qwentts.sh waits for GGUF load + CUDA initialization.
TTS_QWENTTS_START_TIMEOUT=180

# Known-good accelerated Kokoro baseline retained alongside Wavhost for A/B
# testing and Android-reader compatibility.
TTS_KOKORO_PORT=8880
TTS_KOKORO_GPU=0
TTS_KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:v0.3.0-amd64

# Benchmark defaults. These do not affect the servers themselves.
# Leave blank to store retained WAV/metadata artifacts under
# {TTS_DATA_ROOT}/benchmarks.
TTS_BENCH_OUTPUT_DIR=
TTS_BENCH_QWEN_MODEL=qwen-0.6-customvoice
TTS_BENCH_QWEN_VOICE=Ryan
TTS_BENCH_QWENTTS_MODEL=qwen-0.6-customvoice-q8-ggml
TTS_BENCH_QWENTTS_VOICE=ryan
TTS_BENCH_KOKORO_MODEL=kokoro
TTS_BENCH_KOKORO_VOICE=af_heart

