# Local TTS service configuration.
# Setup uses this to detect service config migrations. Leave unchanged.
LOCAL_AI_SERVICE_CONFIG_VERSION=7

# Shared storage defaults come from ../../.env. TTS has its own bind address so
# exposing the reader endpoint on a LAN does not also expose unrelated services.
TTS_BIND_ADDRESS=127.0.0.1

# ./start.sh runs one operational backend at a time.
# Choices: qwentts, kokoro-gpu, kokoro-cpu, indextts25,
#          chatterbox-flash, chatterbox-nano.
TTS_ACTIVE_BACKEND=qwentts

# Leave blank to use {LOCAL_AI_SERVICE_ROOT}/tts.
TTS_DATA_ROOT=

# Optional model bundles provisioned by setup. Candidate models are opt-in so a
# normal qwentts/Kokoro setup does not download or build multi-GB experiments.
TTS_MODEL_BUNDLES=qwen-0.6-customvoice-q8-gguf

# Fast quantized qwentts.cpp backend. The cuda12 image includes Pascal sm_61.
TTS_QWENTTS_PORT=11436
TTS_QWENTTS_GPU=1
TTS_QWENTTS_IMAGE=ghcr.io/serveurpersocom/qwentts.cpp:cuda12
TTS_QWENTTS_MODEL_ALIAS=qwen-0.6-customvoice-q8-ggml
TTS_QWENTTS_MODEL_FILE=qwen-talker-0.6b-customvoice-Q8_0.gguf
TTS_QWENTTS_CODEC_FILE=qwen-tokenizer-12hz-Q8_0.gguf
TTS_QWENTTS_LANGUAGE=English
TTS_QWENTTS_CLAMP_FP16=0
TTS_QWENTTS_NO_FA=0
TTS_QWENTTS_START_TIMEOUT=180

# Client-facing qwentts gateway.
TTS_QWENTTS_GATEWAY_IMAGE=local/qwentts-gateway:py313
TTS_QWENTTS_GATEWAY_PORT=11437
TTS_QWENTTS_GATEWAY_RETRIES=2
TTS_QWENTTS_MP3_BITRATE_KBPS=64

# Known-good Kokoro baselines.
TTS_KOKORO_GPU_PORT=8880
TTS_KOKORO_GPU=0
TTS_KOKORO_GPU_IMAGE=ghcr.io/remsky/kokoro-fastapi-gpu:v0.3.0-amd64
TTS_KOKORO_CPU_PORT=8881
TTS_KOKORO_CPU_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.3.0-amd64

# Cross-hardware experiment runtime. PyTorch 2.7.1/cu126 is intentionally used
# on BOTH the GTX 1080 Ti and RTX 3090 so Pascal and Ampere are compared under
# one software stack. The cu126 wheel line retains sm_61 and sm_86 kernels.
TTS_EXPERIMENT_TORCH_VERSION=2.7.1
TTS_EXPERIMENT_TORCHAUDIO_VERSION=2.7.1
TTS_EXPERIMENT_TORCHVISION_VERSION=0.22.1
TTS_EXPERIMENT_TORCH_CUDA_TAG=cu126

# IndexTTS 2.5. Upstream source is pinned after the public do_sample fix.
TTS_INDEXTTS25_PORT=11438
TTS_INDEXTTS25_GPU=1
TTS_INDEXTTS25_IMAGE=local/indextts25:cu126
TTS_INDEXTTS25_MODEL_ALIAS=indextts-2.5
TTS_INDEXTTS25_SOURCE_REVISION=6e353fe2611afb6a7e3f13a7a6be3d4e27142119
TTS_INDEXTTS25_MODEL_REVISION=c39ce5ba981572cb187443877ff559dfb246ce63
TTS_INDEXTTS25_W2VBERT_REVISION=da985ba0987f70aaeb84a80f2851cfac8c697a7b
TTS_INDEXTTS25_MASKGCT_REVISION=265c6cef07625665d0c28d2faafb1415562379dc
TTS_INDEXTTS25_CAMPPLUS_REVISION=e4b6ede7ce16997aff4ae69fbca1f0175e2afede
TTS_INDEXTTS25_BIGVGAN_REVISION=633ff708ed5b74903e86ff1298cf4a98e921c513
TTS_INDEXTTS25_DTYPE=auto
TTS_INDEXTTS25_START_TIMEOUT=900

# Chatterbox shared runtime source pins.
TTS_CHATTERBOX_IMAGE=local/chatterbox-experiments:cu126
TTS_CHATTERBOX_SOURCE_REVISION=5de7a54aa4e5e2baadb0182dde554908b48b85c2
TTS_CHATTERBOX_PERTH_REVISION=ce86c49d029f42272c1902eccb675556b9ed2330

# Chatterbox Flash. The first proof deliberately uses the portable Torch
# attention implementation with CUDA graphs disabled; optimize only after the
# same retained audio passes listening review on Pascal and Ampere.
TTS_CHATTERBOX_FLASH_PORT=11439
TTS_CHATTERBOX_FLASH_GPU=1
TTS_CHATTERBOX_FLASH_MODEL_ALIAS=chatterbox-flash
TTS_CHATTERBOX_FLASH_SOURCE_REVISION=74e05baa8ce574bf2cc571702391a21f1b0d48c5
TTS_CHATTERBOX_FLASH_MODEL_REVISION=4385507288b8197e6dab8b4e6b1603328d549d9d
TTS_CHATTERBOX_FLASH_DTYPE=auto
TTS_CHATTERBOX_FLASH_ENGINE=torch
TTS_CHATTERBOX_FLASH_CUDA_GRAPH=0
TTS_CHATTERBOX_FLASH_STEPS=10
TTS_CHATTERBOX_FLASH_START_TIMEOUT=600

# Chatterbox Nano. Uses the same retained Ryan reference WAV as the other
# candidates instead of its bundled voice so A/B listening remains meaningful.
TTS_CHATTERBOX_NANO_PORT=11440
TTS_CHATTERBOX_NANO_GPU=1
TTS_CHATTERBOX_NANO_MODEL_ALIAS=chatterbox-nano
TTS_CHATTERBOX_NANO_SOURCE_REVISION=5de7a54aa4e5e2baadb0182dde554908b48b85c2
TTS_CHATTERBOX_NANO_MODEL_REVISION=71ccd1d0081b430592cea481f4307e764e07bc64
TTS_CHATTERBOX_NANO_START_TIMEOUT=600

# Benchmark defaults. These do not affect the servers themselves.
TTS_BENCH_OUTPUT_DIR=
TTS_BENCH_QWENTTS_MODEL=qwen-0.6-customvoice-q8-ggml
TTS_BENCH_QWENTTS_VOICE=ryan
TTS_BENCH_KOKORO_MODEL=kokoro
TTS_BENCH_KOKORO_VOICE=af_heart
TTS_BENCH_CANDIDATE_VOICE=ryan
