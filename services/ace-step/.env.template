# ACE-Step-specific configuration.
# Setup uses this to detect service config migrations. Leave unchanged.
LOCAL_AI_SERVICE_CONFIG_VERSION=2

# Shared storage and bind defaults come from ../../.env.

# Leave blank to use {LOCAL_AI_SERVICE_ROOT}/ace-step.
# To reuse the pre-local-ai installation instead, set:
# ACESTEP_DATA_ROOT=/data/service/docker/ace-step
ACESTEP_DATA_ROOT=

ACESTEP_UI_PORT=7860
ACESTEP_API_PORT=8001

# Host NVIDIA GPU indices used by the UI and optional API service.
ACESTEP_GPU=1
ACESTEP_API_GPU=1

ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B

# Explicit setup-time model download source: auto, huggingface, or modelscope.
ACESTEP_DOWNLOAD_SOURCE=huggingface

ACESTEP_REPO=https://github.com/ACE-Step/ACE-Step-1.5.git
# Exploratory default. Pin to a tag/commit once a rebuild needs to be stable.
ACESTEP_REF=main
ACESTEP_IMAGE=local/ace-step:1.5
