ACESTEP_DATA_ROOT=/data/service/docker/ace-step
LOCAL_AI_BIND_ADDRESS=127.0.0.1

ACESTEP_UI_PORT=7860
ACESTEP_API_PORT=8001

# Host NVIDIA GPU index used by the service.
ACESTEP_GPU=1
ACESTEP_API_GPU=1

ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B

ACESTEP_REPO=https://github.com/ACE-Step/ACE-Step-1.5.git
# Exploratory default. Pin to a tag/commit once a rebuild needs to be stable.
ACESTEP_REF=main
ACESTEP_IMAGE=local/ace-step:1.5
